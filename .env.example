# Discord Bot (obtener en https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here
# Opcional: ID del servidor de pruebas para sincronizar /counter al instante (dejar vacío en producción global)
DISCORD_GUILD_ID=

# Databricks SQL Warehouse Serverless
# IMPORTANTE: usa aquí el token 'deadlock-bot-sql' (Scope: BI Tools), NO el token de GitHub Actions.
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=deadlock

# Frecuencia de refresco automático del snapshot en RAM (horas)
REFRESH_INTERVAL_HOURS=12

# Puerto HTTP interno para monitoreo (/health); usa 0 para desactivar
HEALTH_PORT=8080

# Opcional: clave para api.deadlock-api.com (solo si ejecutas ingestion/ manualmente)
DEADLOCK_API_KEY=

# Nivel de logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
